<div>
    <h2>Lista de productos</h2>
    <div id="productList">
        <ul>
            {{#each prods}}
            <li>Titulo:{{title}},
                Id:{{id}},
                Precio:{{precio}},
                Stock:{{stock}}
            </li>
            {{/each}}
        </ul>
    </div>
    <a href="http://localhost:8080/realTimeProducts">
        <h2>Agregar Productos</h2>
        
    </a>
</div>

<script src="socket.io/socket.io.js"></script>
<script type="js" src="../../public/js/index.js"></script>